{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s4status",
  "account_id": "6b40720fcf7fc5bcc9a75cf47654ef4e",
  "main": "src/worker.ts",
  "routes": [{ "pattern": "s4status.sessapps.com", "custom_domain": true }],
  "compatibility_date": "2026-09-25",
  "vars": {
    "DB_BRIDGE_URL": "https://db.sessapps.com/sql"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "s4status",
      "database_id": "81613e59-866c-4492-a74f-0bba640b2ddc"
    }
  ],
  // Static SPA served from Cloudflare Workers.
  // The build output is wired up automatically by @cloudflare/vite-plugin.
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Serve the API and docs from the worker before asset lookup; otherwise
    // SPA fallback emulation intercepts navigations to /docs in dev.
    "run_worker_first": ["/api/*", "/docs", "/docs/*", "/robots.txt"]
  }
}
