{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s4status",
  "account_id": "6b40720fcf7fc5bcc9a75cf47654ef4e",
  "main": "src/worker.ts",
  "routes": [{ "pattern": "s4status.sessapps.com", "custom_domain": true }],
  "compatibility_date": "2026-09-25",
  // Static SPA served from Cloudflare Workers.
  // The build output is wired up automatically by @cloudflare/vite-plugin.
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Serve the API and docs from the worker before asset lookup; otherwise
    // SPA fallback emulation intercepts navigations to /docs in dev.
    "run_worker_first": ["/api/*", "/docs", "/docs/*"]
  }
}
